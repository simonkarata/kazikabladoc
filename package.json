{
  "name": "kabla",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "Kabla — a tiny AI-assisted patient handover tool. Before the diagnosis, get the story right.",
  "scripts": {
    "dev": "concurrently -k -n web,api -c cyan,green \"vite\" \"tsx watch server/index.ts\"",
    "dev:web": "vite",
    "server": "tsx watch server/index.ts",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "node scripts/testSafety.mjs",
    "test:e2e": "node scripts/e2e.mjs",
    "test:ai": "node scripts/liveAI.mjs"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.123.0",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "concurrently": "^9.2.4",
    "puppeteer-core": "^24.43.1",
    "tsx": "^4.23.13",
    "typescript": "^5.6.3",
    "vite": "^5.4.11"
  }
}
